{
  "name": "ai-fight-club",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Original 2D AI-vs-AI fighting game (Street Fighter-style rules, original characters only).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:api",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ladder": "npx tsx scripts/run-ladder.ts",
    "commander": "npx tsx scripts/commander.ts",
    "build:api": "esbuild src/commander/apiEntry.ts --bundle --platform=node --format=esm --outfile=api/[...path].js --legal-comments=none"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^3.2.7"
  }
}
